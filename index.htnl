<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MPSC Notes | Study Portal</title>
    
    <!-- Google Fonts: Noto Sans Devanagari for Marathi/English mixed content -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Tailwind Custom Configuration -->
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans Devanagari"', 'sans-serif'],
                    },
                    colors: {
                        // Light Mode Palette
                        lightBg: '#FAF7F2',
                        lightSurface: '#FFFFFF',
                        lightHeader: '#FFFDF9',
                        lightMain: '#29231E',
                        lightSec: '#6B6259',
                        brandPartLight: '#8B5E3C', // Brown
                        subjLight: '#2563EB',      // Blue
                        chapLight: '#15803D',      // Green
                        highlightLight: '#B7791F', // Amber
                        borderLight: '#E5DCD2',
                        footerLight: '#2F2924',
                        
                        // Dark Mode Palette
                        darkBg: '#0F1115',
                        darkSurface: '#171B21',
                        darkHeader: '#181C23',
                        darkMain: '#E8EAED',
                        darkSec: '#A6ADB8',
                        brandPartDark: '#D39B6A',  // Warm Brown
                        subjDark: '#60A5FA',       // Soft Blue
                        chapDark: '#4ADE80',       // Soft Green
                        highlightDark: '#FBBF24',  // Amber
                        borderDark: '#2B313A',
                        footerDark: '#0B0D10',
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Smooth transitions for theme switching */
        body { transition: background-color 0.3s, color 0.3s; }
        .chevron { transition: transform 0.3s ease; }
        
        /* Custom Scrollbar for better reading experience */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
    </style>
</head>

<body class="bg-lightBg dark:bg-darkBg text-lightMain dark:text-darkMain antialiased">

    <!-- Sticky Header -->
    <header class="sticky top-0 z-50 bg-lightHeader dark:bg-darkHeader border-b border-borderLight dark:border-borderDark shadow-sm">
        <div class="max-w-[1100px] mx-auto px-4 sm:px-6 h-[60px] md:h-[68px] flex items-center justify-between">
            <!-- Logo / Name -->
            <a href="#" class="text-xl md:text-2xl font-bold flex items-center gap-2">
                📚 <span class="text-lightMain dark:text-darkMain">MPSC Notes</span>
            </a>
            
            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center gap-6 font-medium">
                <a href="#" class="text-lightSec hover:text-subjLight dark:text-darkSec dark:hover:text-subjDark transition-colors">Home</a>
                <a href="#about" class="text-lightSec hover:text-subjLight dark:text-darkSec dark:hover:text-subjDark transition-colors">About</a>
                <a href="#contact" class="text-lightSec hover:text-subjLight dark:text-darkSec dark:hover:text-subjDark transition-colors">Contact</a>
                
                <!-- Theme Toggle Desktop -->
                <button onclick="toggleTheme()" class="p-2 rounded-lg bg-borderLight/50 dark:bg-borderDark hover:bg-borderLight dark:hover:bg-borderDark/80 transition-colors" aria-label="Toggle Dark Mode">
                    <span id="theme-icon-desktop" class="text-lg">🌙</span>
                </button>
            </nav>

            <!-- Mobile Menu Button -->
            <button onclick="toggleMobileMenu()" class="md:hidden p-2 text-2xl text-lightSec dark:text-darkSec focus:outline-none">
                ☰
            </button>
        </div>

        <!-- Mobile Slide-down Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-lightHeader dark:bg-darkHeader border-b border-borderLight dark:border-borderDark px-4 py-4 flex flex-col gap-4 font-medium shadow-lg">
            <a href="#" onclick="toggleMobileMenu()" class="block text-lightMain dark:text-darkMain p-2 rounded hover:bg-borderLight/50 dark:hover:bg-borderDark">Home</a>
            <a href="#about" onclick="toggleMobileMenu()" class="block text-lightMain dark:text-darkMain p-2 rounded hover:bg-borderLight/50 dark:hover:bg-borderDark">About Us</a>
            <a href="#contact" onclick="toggleMobileMenu()" class="block text-lightMain dark:text-darkMain p-2 rounded hover:bg-borderLight/50 dark:hover:bg-borderDark">Contact</a>
            <div class="w-full h-px bg-borderLight dark:bg-borderDark my-1"></div>
            <button onclick="toggleTheme(); toggleMobileMenu()" class="flex items-center gap-3 p-2 rounded hover:bg-borderLight/50 dark:hover:bg-borderDark w-full text-left">
                <span id="theme-icon-mobile">🌙</span> <span class="text-lightMain dark:text-darkMain">Toggle Theme</span>
            </button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-[1100px] mx-auto w-full px-4 sm:px-6 py-6 md:py-10">
        
        <!-- Search Bar -->
        <div class="mb-8 relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="text-lightSec dark:text-darkSec">🔎</span>
            </div>
            <input type="text" class="w-full pl-10 pr-4 py-3 rounded-xl bg-lightSurface dark:bg-darkSurface border border-borderLight dark:border-borderDark text-lightMain dark:text-darkMain placeholder-lightSec dark:placeholder-darkSec focus:outline-none focus:ring-2 focus:ring-subjLight dark:focus:ring-subjDark transition-all" placeholder="Search subjects, chapters, topics...">
        </div>

        <!-- Subject List Area -->
        <div class="flex flex-col gap-4">
            
            <!-- 🔵 SUBJECT 1: Current Affairs (Template) -->
            <div class="rounded-xl bg-lightSurface dark:bg-darkSurface border border-borderLight dark:border-borderDark shadow-sm overflow-hidden">
                <button onclick="toggleAccordion('subj-1', 'icon-s1')" class="w-full text-left flex items-center justify-between p-4 md:p-5 border-l-4 border-subjLight dark:border-subjDark hover:bg-[#F3F4F6] dark:hover:bg-[#20252D] transition-colors focus:outline-none">
                    <div class="flex items-center gap-3">
                        <span class="text-lg md:text-xl font-bold text-subjLight dark:text-subjDark">Current Affairs</span>
                    </div>
                    <span id="icon-s1" class="chevron text-lightSec dark:text-darkSec">▼</span>
                </button>

                <div id="subj-1" class="hidden flex-col gap-3 p-3 md:p-5 pt-0 bg-lightSurface dark:bg-darkSurface">
                    
                    <!-- 🟤 PART A -->
                    <div class="mt-3 border border-borderLight dark:border-borderDark rounded-lg overflow-hidden bg-lightBg dark:bg-[#13161B]">
                        <button onclick="toggleAccordion('part-1a', 'icon-p1a')" class="w-full text-left p-3 md:p-4 border-l-4 border-brandPartLight dark:border-brandPartDark hover:bg-[#EAE5DF] dark:hover:bg-[#1D2128] transition-colors flex items-center justify-between focus:outline-none">
                            <div class="flex flex-col gap-1">
                                <span class="text-xs md:text-sm font-bold text-brandPartLight dark:text-brandPartDark uppercase tracking-wider">Part A</span>
                                <span class="text-base md:text-lg font-semibold text-lightMain dark:text-darkMain">Month-wise Current Affairs</span>
                            </div>
                            <span id="icon-p1a" class="chevron text-lightSec dark:text-darkSec text-lg">▾</span>
                        </button>
                        
                        <!-- 🟢 Chapters in Part A -->
                        <div id="part-1a" class="hidden flex-col gap-2 p-3 bg-lightBg dark:bg-[#13161B]">
                            
                            <!-- Chapter 1 -->
                            <a href="january2026.html" class="block w-full p-3 rounded-md bg-lightSurface dark:bg-darkSurface border-l-4 border-chapLight dark:border-chapDark hover:bg-[#E5F5EC] dark:hover:bg-[#182B1E] border border-borderLight dark:border-borderDark transition-colors group">
                                <div class="flex flex-col gap-1">
                                    <span class="text-xs md:text-sm font-bold text-chapLight dark:text-chapDark uppercase">Chapter 1</span>
                                    <span class="text-sm md:text-base font-medium text-lightMain dark:text-darkMain group-hover:text-chapLight dark:group-hover:text-chapDark transition-colors">January 2026 Current Affairs</span>
                                </div>
                            </a>
                            
                            <!-- Note: You can copy-paste the above <a> block for Chapter 2, 3, etc. -->

                        </div>
                    </div>

                </div>
            </div>

            <!-- Note: You can copy the entire SUBJECT block above and paste it below for "इतिहास", "भूगोल", etc. -->

        </div>

        <!-- 🟠 ABOUT US SECTION -->
        <section id="about" class="mt-12 p-6 md:p-8 rounded-xl bg-lightSurface dark:bg-darkSurface border-t-4 border-highlightLight dark:border-highlightDark border border-borderLight dark:border-borderDark shadow-sm">
            <h2 class="text-lg md:text-xl font-bold text-highlightLight dark:text-highlightDark mb-4 uppercase tracking-wide">About Us</h2>
            <p class="text-lightSec dark:text-darkSec text-base md:text-lg leading-relaxed max-w-3xl">
                Notes designed for competitive exam aspirants, with a focus on simple, structured and revision-friendly study material. <br><br>
                <strong class="text-lightMain dark:text-darkMain font-semibold">MPSC Group C 2026</strong> ची तयारी करणाऱ्या विद्यार्थ्यांसाठी हे एक Free Study Platform आहे. येथे सर्व विषयांच्या परीक्षाभिमुख Notes, MCQ सराव प्रश्न आणि Revision सामग्री एकाच ठिकाणी उपलब्ध करून दिली जाते.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 text-sm font-medium text-lightMain dark:text-darkMain">
                <span class="px-3 py-1 bg-lightBg dark:bg-[#13161B] rounded-full border border-borderLight dark:border-borderDark">सोपे Notes</span>
                <span class="px-3 py-1 bg-lightBg dark:bg-[#13161B] rounded-full border border-borderLight dark:border-borderDark">स्मार्ट Practice</span>
                <span class="px-3 py-1 bg-lightBg dark:bg-[#13161B] rounded-full border border-borderLight dark:border-borderDark">प्रभावी Revision</span>
            </div>
        </section>

        <!-- Warning Section -->
        <div class="mt-8 p-4 rounded-lg bg-orange-50 dark:bg-orange-950/30 border border-orange-200 dark:border-orange-800">
            <h3 class="text-orange-800 dark:text-orange-400 font-bold mb-2 flex items-center gap-2">
                <span>⚠️</span> महत्त्वाची सूचना:
            </h3>
            <p class="text-sm md:text-base text-orange-900 dark:text-orange-300 leading-relaxed">
                विद्यार्थ्यांना शक्य तितकी अचूक आणि उपयुक्त माहिती देण्याचा आमचा प्रयत्न आहे. तरीही Notes मध्ये अनवधानाने काही त्रुटी राहू शकतात. त्यामुळे परीक्षेच्या दृष्टीने महत्त्वाची माहिती अधिकृत स्रोतांमधून पडताळून पाहावी. काही चूक किंवा सुधारणा आढळल्यास कृपया telegram वर आम्हाला कळवा. Telegram link खाली दिलेली आहे.
            </p>
        </div>

    </main>

    <!-- Footer -->
    <footer id="contact" class="bg-footerLight dark:bg-footerDark text-gray-300 py-8 border-t border-gray-800 mt-8">
        <div class="max-w-[1100px] mx-auto px-4 sm:px-6 flex items-center justify-center">
            <!-- Telegram Contact ONLY -->
            <div class="flex items-center gap-4">
                <p class="text-sm md:text-base font-medium text-lightSec dark:text-darkSec">Contact us on Telegram</p>
                <a href="#" class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue-500 hover:bg-blue-600 transition-colors text-white" aria-label="Telegram">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.287 5.906c-.778.324-2.334.994-4.666 2.01-.378.15-.577.298-.595.442-.03.243.275.339.69.47l.175.055c.408.133.958.288 1.243.297.26.008.547-.1.86-.32 2.136-1.445 3.238-2.164 3.303-2.158.056.005.076.023.056.056-.057.094-1.22 1.15-1.782 1.67-.183.17-.33.306-.342.319-.033.036-.067.072-.1.107-.26.26-.52.52-.057.82.46.3.92.598 1.37.896.44.292.88.585 1.37.915.17.114.34.228.51.341.34.226.65.433.99.418.175-.008.35-.152.48-.48.24-1.02.76-3.26.97-4.48.04-.23.04-.41.02-.53-.02-.12-.08-.22-.22-.27-.2-.07-.63-.03-1.14.15z"/>
                    </svg>
                </a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Check local storage or system preference for theme
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
            updateThemeIcons('☀️');
        } else {
            document.documentElement.classList.remove('dark');
            updateThemeIcons('🌙');
        }

        // Theme Toggle Function
        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                updateThemeIcons('🌙');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                updateThemeIcons('☀️');
            }
        }

        function updateThemeIcons(icon) {
            document.getElementById('theme-icon-desktop').textContent = icon;
            document.getElementById('theme-icon-mobile').textContent = icon;
        }

        // Mobile Menu Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Accordion Toggle Logic
        function toggleAccordion(contentId, iconId) {
            const content = document.getElementById(contentId);
            const icon = document.getElementById(iconId);
            
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                content.classList.add('flex');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                content.classList.remove('flex');
                icon.classList.remove('rotate-180');
            }
        }
    </script>
</body>
</html>

